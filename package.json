{
  "name": "transcript-study-view",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first reading view for official YouTube and TED transcripts.",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && xvfb-run -a playwright test",
    "lint": "eslint .",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "build:extension": "wxt build",
    "build:site": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "verify:live": "xvfb-run -a node scripts/verify-live-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.8",
    "@playwright/test": "1.58.2",
    "@types/chrome": "^0.1.0",
    "@types/jsdom": "^21.1.7",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "playwright-core": "1.58.2",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.7"
  }
}
